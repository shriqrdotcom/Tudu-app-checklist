# ============================================================
# TU DU — environment template (Vite)
# Copy to `.env.local` and fill in values. Never commit real secrets.
# ============================================================

# --- Client-side (public) Supabase credentials ---
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SERVER-ONLY secret (optional; unused by this client-only app) ---
# Never prefix with VITE_/NEXT_PUBLIC_. Never expose to browser code.
# Used ONLY by scripts/create-owner.ts to bootstrap the single owner account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner bootstrap (scripts/create-owner.ts only, server-side) ---
# The single login email for the private owner account.
OWNER_EMAIL=

# --- VAPID Keys for Web Push Notifications (Phase 10A) ---
# Generate with: npx web-push generate-vapid-keys
# Public key is SAFE to expose to client (used in SW + subscribe)
VITE_VAPID_PUBLIC_KEY=
# Private key MUST NEVER enter the client bundle - only in Supabase Edge Function secrets
# Add to Supabase Dashboard → Edge Functions → Secrets as VAPID_PRIVATE_KEY
# VAPID_PRIVATE_KEY=

# Notes:
# - The anon key is safe for client use because every table and storage
#   bucket is protected by Row Level Security policies (see supabase/schema.sql).
# - For Vercel deployments, set VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_VAPID_PUBLIC_KEY
#   in Project → Settings → Environment Variables, then redeploy.
# - In Supabase Dashboard, add VAPID_PRIVATE_KEY and CRON_SECRET to Edge Function secrets.
