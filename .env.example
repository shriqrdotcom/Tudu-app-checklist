# ============================================================
# TU DU — environment template (Vite)
# Copy to `.env.local` and fill in values. Never commit real secrets.
# ============================================================

# --- Client-side (public) Supabase credentials ---
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SERVER-ONLY secret (optional; unused by this client-only app) ---
# Never prefix with VITE_/NEXT_PUBLIC_. Never expose to browser code.
# Only needed if a future server runtime performs privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Notes:
# - The anon key is safe for client use because every table and storage
#   bucket is protected by Row Level Security policies (see supabase/schema.sql).
# - For Vercel deployments, set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
#   in Project → Settings → Environment Variables, then redeploy.
